{
  "name": "dynamic-task-plugin",
  "version": "1.0.0",
  "description": "OpenCode plugin for dynamic subagent task execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test src/tests/*.test.js",
    "test:coverage": "c8 --check-coverage --lines 90 --branches 80 --functions 90 node --test src/tests/*.test.js",
    "test:duplication": "jscpd src --config .jscpd.json",
    "lint": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "plugin",
    "subagent",
    "task"
  ],
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.20"
  }
}
