{
  "name": "dynamic-task-plugin",
  "version": "1.0.0",
  "description": "OpenCode plugin for dynamic subagent task execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run lint && npm run test:duplication && node --test src/tests/*.test.js",
    "test:coverage": "npm run build && npm run lint && npm run test:duplication && c8 --check-coverage --lines 90 --branches 80 --functions 90 node --test src/tests/*.test.js",
    "test:duplication": "node scripts/duplicate-gate.mjs",
    "test:cross-boundary": "node scripts/cross-boundary-clones.mjs",
    "lint": "node scripts/lint-budget.mjs && biome check && knip",
    "watch": "tsc --watch",
    "lint:report": "oxlint --type-aware",
    "lint:budget": "node scripts/lint-budget.mjs --write"
  },
  "keywords": [
    "opencode",
    "plugin",
    "subagent",
    "task"
  ],
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@jscpd/tokenizer": "4.2.6",
    "@opencode/client": "^2.2.3",
    "@opencode/plugin": "^2.2.3",
    "@opencode/schema": "^2.2.3",
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/node": "^26.5.1",
    "c8": "^12.0.0",
    "knip": "^6.41.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2"
  }
}
