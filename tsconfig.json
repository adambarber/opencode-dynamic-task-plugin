{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 for `toSorted` (the lint bans in-place `sort`): the host runs
    // Node 26, so no emit change is needed — this only types the library.
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // src/tui is IN: the v2 port keeps every pure builder (rows, options, width gate)
  // and re-mounts only the flows — `dialog.select` promises instead of `replace`ed
  // JSX, `keymap.layer` behind a null slot component instead of `registerLayer`.
  // The palette command cannot live in `setup` itself: `keymap.layer` reads Solid
  // context, so it runs in a slot render the host owns, never in our module scope.
  "exclude": ["node_modules", "dist"]
}